# Copy to deploy/.env.shipany on the server. Never commit the real file.

# Bind the application to localhost and terminate TLS at Nginx/Caddy.
BIND_HOST=127.0.0.1
SERVER_PORT=8080
TZ=Asia/Shanghai

# `simple` is only for pre-production ShipAny integration: a valid projected
# key can call the gateway without the legacy balance check. Do not sell traffic
# in this mode. `standard` retains the legacy gateway balance check and will
# reject newly projected ShipAny users whose gateway balance is zero.
RUN_MODE=simple

# PostgreSQL and Redis are private Docker services in the base Compose stack.
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace_with_a_long_random_value
POSTGRES_DB=sub2api
REDIS_PASSWORD=replace_with_a_different_long_random_value

# Generate independent values on the server with: openssl rand -hex 32
JWT_SECRET=replace_with_64_hex_characters
TOTP_ENCRYPTION_KEY=replace_with_a_different_64_hex_value
PLATFORM_IDENTITY_SECRET=replace_with_a_third_independent_64_hex_value

# ShipAny signs control-plane calls with PLATFORM_IDENTITY_SECRET.
PLATFORM_IDENTITY_ISSUER=shipany
PLATFORM_IDENTITY_AUDIENCE=sub2api-gateway
PLATFORM_IDENTITY_VERSION=v1

# Projected ShipAny keys use automatic channel routing instead of binding to
# one legacy gateway group. Keep this enabled for the ShipAny data plane.
GATEWAY_CHANNEL_ROUTING_ENABLED=true

# Keep disabled for the first boot. Shadow mode may be enabled only after the
# Cloudflare Worker is configured with the matching independent secret.
CANONICAL_WALLET_MODE=disabled
CANONICAL_WALLET_CONTROL_PLANE_URL=https://all-model-router.app
CANONICAL_WALLET_ISSUER=sub2api-gateway
CANONICAL_WALLET_AUDIENCE=shipany-control-plane
CANONICAL_WALLET_SECRET=
CANONICAL_WALLET_VERSION=v1

# Conservative defaults; tune only after observing production-shaped traffic.
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=10
