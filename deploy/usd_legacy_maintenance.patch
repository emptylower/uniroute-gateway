+// Temporary admission-only patch for the PRE-USD version; does not change money or protocols.
+package middleware
+
+import (
+	"github.com/gin-gonic/gin"
+	"net/http"
+	"os"
+	"strings"
+)
+
+func LegacyUsdCutoverMaintenance() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if !strings.EqualFold(os.Getenv("USD_LEDGER_MAINTENANCE"), "true") {
+			c.Next()
+			return
+		}
+		p := c.Request.URL.Path
+		writing := strings.HasPrefix(p, "/api/v1/auth/oauth/") || c.Request.Method != http.MethodGet && c.Request.Method != http.MethodHead && c.Request.Method != http.MethodOptions
+		websocket := strings.EqualFold(c.GetHeader("Upgrade"), "websocket")
+		if !writing && !websocket {
+			c.Next()
+			return
+		}
+		// Existing internal settlement/reconciliation and payment completion remain live.
+		draining := strings.HasPrefix(p, "/api/internal/") && !(strings.Contains(p, "/inference/") && (strings.HasSuffix(p, "/tasks") || strings.HasSuffix(p, "/quote")))
+		draining = draining || strings.HasPrefix(p, "/api/v1/payment/webhook/") || strings.HasPrefix(p, "/api/v1/admin/wallet/reconciliation/")
+		if draining && !websocket {
+			c.Next()
+			return
+		}
+		c.Header("Retry-After", "60")
+		c.AbortWithStatusJSON(http.StatusServiceUnavailable, gin.H{"error": gin.H{"type": "maintenance", "message": "Wallet cutover maintenance"}})
+	}
+}
