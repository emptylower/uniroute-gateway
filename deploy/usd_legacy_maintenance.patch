+package middleware
+
+import (
+	"github.com/gin-gonic/gin"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestLegacyUsdCutoverPreservesOnlyDrain(t *testing.T) {
+	t.Setenv("USD_LEDGER_MAINTENANCE", "true")
+	for _, tc := range []struct {
+		method, path, upgrade string
+		want                  int
+	}{
+		{"GET", "/api/v1/auth/oauth/oidc/callback", "", 503}, {"GET", "/api/v1/payment/webhook/alipay", "", 204}, {"POST", "/v1/chat/completions", "", 503}, {"GET", "/v1/responses", "websocket", 503},
+		{"POST", "/api/internal/v1/users/x/inference/tasks", "", 503}, {"POST", "/api/internal/v1/users/x/inference/quote", "", 503},
+		{"POST", "/api/internal/v1/users/x/inference/legacy-read", "", 204}, {"POST", "/api/internal/v1/wallet/settlements", "", 204},
+		{"POST", "/api/v1/payment/webhook/stripe", "", 204}, {"GET", "/v1/images/tasks/old", "", 204},
+	} {
+		t.Run(tc.method+tc.path, func(t *testing.T) {
+			r := gin.New()
+			r.Use(LegacyUsdCutoverMaintenance())
+			r.Any("/*path", func(c *gin.Context) { c.Status(204) })
+			req := httptest.NewRequest(tc.method, tc.path, nil)
+			req.Header.Set("Upgrade", tc.upgrade)
+			w := httptest.NewRecorder()
+			r.ServeHTTP(w, req)
+			if w.Code != tc.want {
+				t.Fatalf("status=%d want%d", w.Code, tc.want)
+			}
+		})
+	}
+}
